{
  "name": "twisitter-site",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build-prelaunch": "yarn build && node scripts/prelaunch.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "node --test test/*.test.mjs",
    "sync-privacy": "cp ../twisitter/PRIVACY.md src/text/privacy.md"
  },
  "dependencies": {
    "astro": "^5.0.0"
  }
}
