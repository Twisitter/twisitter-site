# Headers for the site's files (Cloudflare's static assets). The pages carry the
# same content policy in a meta tag; frame-ancestors only works here.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# The report form runs its own script and posts to /api/feedback, so its policy
# is the one in its meta tag (Base.astro's `script`). X-Frame-Options stands in
# for frame-ancestors there.
/feedback
  ! Content-Security-Policy
  X-Frame-Options: DENY
