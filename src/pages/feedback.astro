---
import Base from '../layouts/Base.astro'
import shared from '../../shared.json'
import { formSettings } from '../lib/report-settings.js'
// The extension's "Report a problem" opens this page with its details in the
// link's #fragment (its report.ts). A private report goes to /api/feedback
// (worker/app.js); a public one is the person's own GitHub issue. The script
// is src/lib/feedback-form.js, set up by shared.json.
---
<Base
  title="Report a problem · Twisitter"
  description="Tell the developer about a problem with Twisitter, privately or as a public GitHub issue. Ideas and questions are welcome too."
  path="/feedback"
  script
>
  <main id="main" class="container">
    <article class="prose fb">
      <h1>Report a problem</h1>
      <p class="fb-lead">Something not working right, an idea, or a question: all welcome.</p>

      <!-- shown when no details came along: a visit that didn't come from the extension, or Deny on Firefox's
           data question, which the extension's button asks again each time until it gets Allow -->
      <aside id="fb-from-extension" class="fb-hint" hidden>
        <img class="fb-hint-mark" src="/assets/mark.svg" alt="" width="28" height="28" />
        <div>
          <p>
            <strong>Have Twisitter installed?</strong> Report from the extension, and the details that help find a
            problem come along. Click Twisitter's icon in your browser's toolbar (it may be under the puzzle-piece
            Extensions menu), then <strong>Report a problem</strong> at the bottom. This form opens again with the
            extension's version, status and diagnostic log filled in, and you see all of it before anything is sent.
          </p>
          <p>
            In Firefox, choose <strong>Allow</strong> when it asks about "technical and interaction data", or this
            form opens without the details. Chose Deny? It asks again the next time you click Report a problem.
          </p>
        </div>
      </aside>

      <form id="fb-form" class="fb-form" novalidate data-settings={JSON.stringify(formSettings(shared.modules.reports))}>
        <div class="fb-field">
          <label for="fb-type">What is it?</label>
          <select id="fb-type" class="fb-select">
            <option value="bug">A problem</option>
            <option value="feature">An idea</option>
            <option value="question">A question</option>
            <option value="other">Something else</option>
          </select>
        </div>

        <div class="fb-field">
          <label for="fb-message">What happened?</label>
          <textarea id="fb-message" class="fb-textarea" required placeholder="A sentence or two is enough. What did you expect instead?"></textarea>
        </div>

        <!-- shown when the extension's "Report a problem" link brought details along -->
        <div id="fb-details" class="fb-field fb-details" hidden>
          <label class="fb-check">
            <input id="fb-include" type="checkbox" checked />
            <span>Include the details from the extension <span class="fb-optional">(they help find the problem)</span></span>
          </label>
          <p class="fb-note" id="fb-details-line"></p>
          <label class="fb-check fb-check-sub">
            <input id="fb-hide-ids" type="checkbox" />
            <span>Hide post ids <span class="fb-optional">(an id leads to whoever wrote the post, and for your own replies
            that's you, but it helps look into a check that went wrong)</span></span>
          </label>
          <details>
            <summary>See everything included</summary>
            <!-- the extension's log stamps are UTC (its diaglog.ts), which a reader would take for local time -->
            <p class="fb-note">Times in the log are in UTC, not your local time.</p>
            <pre id="fb-details-text" class="fb-pre"></pre>
          </details>
          <p class="fb-note">Never included: your X username, your sessions, or what your posts say.</p>
        </div>

        <div class="fb-field">
          <label for="fb-username">Your X username <span class="fb-optional">(optional, private reports only)</span></label>
          <input id="fb-username" class="fb-input" type="text" autocomplete="off" />
        </div>

        <div class="fb-field">
          <label for="fb-email">Email <span class="fb-optional">(optional, only if you'd like a reply)</span></label>
          <input id="fb-email" class="fb-input" type="email" autocomplete="email" />
        </div>

        <!-- people leave this empty; bots fill it in -->
        <div class="fb-hp" aria-hidden="true">
          <label>Website <input id="fb-website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="fb-actions">
          <div class="fb-action">
            <button type="submit" class="btn btn-primary">Send privately</button>
            <p class="fb-note">Only the developer sees it. Leave an email if you'd like a reply.</p>
          </div>
          <div class="fb-action">
            <button type="button" id="fb-github" class="btn">Post publicly on GitHub</button>
            <p class="fb-note">
              Anyone can read it and add to it, and you can follow the replies. It needs a GitHub account, and post ids
              are always hidden.
            </p>
          </div>
        </div>
        <div id="fb-status" class="fb-status" role="status"></div>
      </form>
    </article>
  </main>

  <script>
    import { startReportForm } from '../lib/feedback-form.js'
    startReportForm()
  </script>
</Base>
